<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="4dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@color/lightBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Ticket type -->
            <TextView
                android:id="@+id/tvItemTicketType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/defaultTextColor"
                android:fontFamily="@font/dbsans_bold" />

            <!-- Name -->
            <TextView
                android:id="@+id/tvItemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/defaultTextColorGrey"
                android:fontFamily="@font/dbsans_regular"
                android:layout_marginTop="2dp" />

            <!-- Date -->
            <TextView
                android:id="@+id/tvItemDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/defaultTextColorGrey"
                android:fontFamily="@font/dbsans_regular"
                android:layout_marginTop="6dp" />

            <!-- Auftragsnr -->
            <TextView
                android:id="@+id/tvItemAuftrag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/dbCoolGray400"
                android:fontFamily="@font/dbsans_regular"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Price + Arrow -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvItemPreis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="@color/defaultTextColor"
                android:fontFamily="@font/dbsans_bold"
                android:layout_marginEnd="8dp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_navigation_arrow_forward"
                android:tint="@color/iconColor"
                android:contentDescription="Details" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
