<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/greyBackground">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/dbCoolGray700"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_dark"
            android:contentDescription="@string/zurueck"
            android:tint="@color/dbWhite" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/dbWhite"
            android:textSize="18sp"
            android:fontFamily="@font/dbsans_bold" />
    </LinearLayout>

    <!-- Red accent line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@color/dbRed" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/background_rounded_corner_bottom"
            android:padding="20dp">

            <!-- Server URL Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Server"
                android:textSize="18sp"
                android:textColor="@color/defaultTextColor"
                android:fontFamily="@font/dbsans_bold"
                android:layout_marginBottom="4dp" />

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:background="@color/dbRed"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.DBTickets.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="@string/server_url">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etServerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:hint="@string/server_url_hint"
                    android:textColor="@color/defaultTextColor"
                    android:fontFamily="@font/dbsans_regular" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Die Server-URL zeigt auf den FastAPI-Backend-Server."
                android:textSize="12sp"
                android:textColor="@color/defaultTextColorGrey"
                android:fontFamily="@font/dbsans_regular"
                android:layout_marginBottom="28dp" />

            <!-- Einstellungen -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Einstellungen"
                android:textSize="18sp"
                android:textColor="@color/defaultTextColor"
                android:fontFamily="@font/dbsans_bold"
                android:layout_marginBottom="4dp" />

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:background="@color/dbRed"
                android:layout_marginBottom="12dp" />

            <!-- Dark Mode toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="28dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dunkler Modus"
                        android:textSize="15sp"
                        android:textColor="@color/defaultTextColor"
                        android:fontFamily="@font/dbsans_regular" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Systemeinstellung folgen"
                        android:textSize="12sp"
                        android:textColor="@color/defaultTextColorGrey"
                        android:fontFamily="@font/dbsans_regular"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchDarkMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/lineDivider"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/speichern"
                style="@style/DBPrimaryButton" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
