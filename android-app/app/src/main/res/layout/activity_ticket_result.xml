<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/greyBackground">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/dbCoolGray700"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:id="@+id/btnBackTicket"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back_dark"
                android:tint="@color/dbWhite"
                android:contentDescription="@string/zurueck" />
        </LinearLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ticket"
            android:textColor="@color/dbWhite"
            android:textSize="18sp"
            android:fontFamily="@font/dbsans_bold" />
    </LinearLayout>

    <!-- Red accent line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@color/dbRed" />

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Barcode area (white background like DB Navigator ticket view) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/lightBackground"
                android:paddingTop="24dp"
                android:paddingBottom="24dp">

                <ImageView
                    android:id="@+id/ivBarcode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:contentDescription="Aztec Barcode" />

                <TextView
                    android:id="@+id/tvBarcodeLoading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Barcode wird geladen..."
                    android:textSize="13sp"
                    android:textColor="@color/defaultTextColorGrey"
                    android:fontFamily="@font/dbsans_regular"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Drop shadow below barcode area -->
            <View
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:background="@drawable/drop_shadow_down" />

            <!-- Name + Details card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="4dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/lightBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvResultName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="17sp"
                        android:textColor="@color/defaultTextColor"
                        android:fontFamily="@font/dbsans_bold" />

                    <TextView
                        android:id="@+id/tvCiv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/defaultTextColorGrey"
                        android:fontFamily="@font/dbsans_regular"
                        android:layout_marginTop="2dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/lineDivider"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="G\u00fcltigkeit"
                        android:textSize="15sp"
                        android:textColor="@color/defaultTextColor"
                        android:fontFamily="@font/dbsans_bold" />

                    <View
                        android:layout_width="40dp"
                        android:layout_height="4dp"
                        android:background="@color/dbRed"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvResultTicketType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/defaultTextColor"
                        android:fontFamily="@font/dbsans_regular"
                        android:lineSpacingExtra="3sp" />

                    <TextView
                        android:id="@+id/tvResultKlasse"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/defaultTextColor"
                        android:fontFamily="@font/dbsans_regular"
                        android:layout_marginTop="3dp" />

                    <TextView
                        android:id="@+id/tvResultPassagierTyp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/defaultTextColor"
                        android:fontFamily="@font/dbsans_regular"
                        android:layout_marginTop="3dp" />

                    <TextView
                        android:id="@+id/tvResultGeburtsdatum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/defaultTextColor"
                        android:fontFamily="@font/dbsans_regular"
                        android:visibility="gone"
                        android:layout_marginTop="3dp" />

                    <TextView
                        android:id="@+id/tvResultGueltigkeit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/defaultTextColor"
                        android:fontFamily="@font/dbsans_regular"
                        android:layout_marginTop="3dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Verbindung card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/sectionVerbindung"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardCornerRadius="4dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/lightBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Verbindung"
                        android:textSize="15sp"
                        android:textColor="@color/defaultTextColor"
                        android:fontFamily="@font/dbsans_bold" />

                    <View
                        android:layout_width="40dp"
                        android:layout_height="4dp"
                        android:background="@color/dbRed"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvVerbindung"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/defaultTextColor"
                        android:fontFamily="@font/dbsans_regular"
                        android:lineSpacingExtra="3sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Buchungsdetails card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="4dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/lightBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Buchungsdetails"
                        android:textSize="15sp"
                        android:textColor="@color/defaultTextColor"
                        android:fontFamily="@font/dbsans_bold" />

                    <View
                        android:layout_width="40dp"
                        android:layout_height="4dp"
                        android:background="@color/dbRed"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvResultCreatedAt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/defaultTextColor"
                        android:fontFamily="@font/dbsans_regular"
                        android:lineSpacingExtra="3sp" />

                    <TextView
                        android:id="@+id/tvAuftragsnummer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/defaultTextColor"
                        android:fontFamily="@font/dbsans_regular"
                        android:layout_marginTop="3dp" />

                    <TextView
                        android:id="@+id/tvResultPreis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textColor="@color/dbGreen"
                        android:fontFamily="@font/dbsans_bold"
                        android:layout_marginTop="3dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Konditionen card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="4dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/lightBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Konditionen"
                        android:textSize="15sp"
                        android:textColor="@color/defaultTextColor"
                        android:fontFamily="@font/dbsans_bold" />

                    <View
                        android:layout_width="40dp"
                        android:layout_height="4dp"
                        android:background="@color/dbRed"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvKonditionen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/defaultTextColorGrey"
                        android:fontFamily="@font/dbsans_regular"
                        android:lineSpacingExtra="3sp" />

                    <TextView
                        android:id="@+id/tvStornierung"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/defaultTextColor"
                        android:fontFamily="@font/dbsans_regular"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvTicketCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/defaultTextColorGrey"
                        android:fontFamily="@font/dbsans_regular"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Watermark -->
            <ImageView
                android:id="@+id/ivWatermark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:layout_marginTop="16dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:contentDescription="Watermark" />

            <!-- Weitere Aktionen Button -->
            <Button
                android:id="@+id/btnWeitereAktionen"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="20dp"
                android:text="Weitere Aktionen"
                style="@style/DBBorderButton" />

            <!-- Hidden fields -->
            <TextView android:id="@+id/tvTicketId" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tvPdfStatus" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
