<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/greyBackground">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/dbCoolGray700"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_dark"
            android:contentDescription="@string/zurueck"
            android:tint="@color/dbWhite" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ticket_form_title"
            android:textColor="@color/dbWhite"
            android:textSize="18sp"
            android:fontFamily="@font/dbsans_bold" />
    </LinearLayout>

    <!-- Red accent line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@color/dbRed" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/background_rounded_corner_bottom"
            android:padding="20dp">

            <!-- Ticket Type Badge -->
            <TextView
                android:id="@+id/tvTicketType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:textColor="@color/dbWhite"
                android:textSize="12sp"
                android:fontFamily="@font/dbsans_bold"
                android:layout_marginBottom="20dp" />

            <!-- Nachname -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.DBTickets.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/nachname">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNachname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:textColor="@color/defaultTextColor"
                    android:fontFamily="@font/dbsans_regular" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Vorname -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.DBTickets.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/vorname">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etVorname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:textColor="@color/defaultTextColor"
                    android:fontFamily="@font/dbsans_regular" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Geburtsdatum -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.DBTickets.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/geburtsdatum">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etGeburtsdatum"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="date"
                    android:focusable="false"
                    android:clickable="true"
                    android:textColor="@color/defaultTextColor"
                    android:fontFamily="@font/dbsans_regular" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Klasse -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/klasse"
                android:textSize="13sp"
                android:textColor="@color/defaultTextColorGrey"
                android:fontFamily="@font/dbsans_regular"
                android:layout_marginBottom="6dp"
                android:layout_marginTop="4dp" />

            <RadioGroup
                android:id="@+id/rgKlasse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <RadioButton
                    android:id="@+id/rbKlasse2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/klasse_2"
                    android:textColor="@color/defaultTextColor"
                    android:fontFamily="@font/dbsans_regular"
                    android:buttonTint="@color/dbRed"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbKlasse1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/klasse_1"
                    android:textColor="@color/defaultTextColor"
                    android:fontFamily="@font/dbsans_regular"
                    android:buttonTint="@color/dbRed" />
            </RadioGroup>

            <!-- Passagier-Typ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/passagier_typ"
                android:textSize="13sp"
                android:textColor="@color/defaultTextColorGrey"
                android:fontFamily="@font/dbsans_regular"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:id="@+id/rgPassagierTyp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <RadioButton
                    android:id="@+id/rbErwachsener"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/erwachsener"
                    android:textColor="@color/defaultTextColor"
                    android:fontFamily="@font/dbsans_regular"
                    android:buttonTint="@color/dbRed"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbJugendlicher"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/jugendlicher"
                    android:textColor="@color/defaultTextColor"
                    android:fontFamily="@font/dbsans_regular"
                    android:buttonTint="@color/dbRed" />
            </RadioGroup>

            <!-- Pass-Typ (for GRP) -->
            <LinearLayout
                android:id="@+id/layoutPassTyp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pass_typ"
                    android:textSize="13sp"
                    android:textColor="@color/defaultTextColorGrey"
                    android:fontFamily="@font/dbsans_regular"
                    android:layout_marginBottom="6dp" />

                <RadioGroup
                    android:id="@+id/rgPassTyp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <RadioButton
                        android:id="@+id/rbConsecutive"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/consecutive"
                        android:textColor="@color/defaultTextColor"
                        android:fontFamily="@font/dbsans_regular"
                        android:buttonTint="@color/dbRed"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbFlexi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/flexi"
                        android:textColor="@color/defaultTextColor"
                        android:fontFamily="@font/dbsans_regular"
                        android:buttonTint="@color/dbRed" />
                </RadioGroup>
            </LinearLayout>

            <!-- Reisetage Spinner -->
            <LinearLayout
                android:id="@+id/layoutReisetage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/reisetage"
                    android:textSize="13sp"
                    android:textColor="@color/defaultTextColorGrey"
                    android:fontFamily="@font/dbsans_regular"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/spinnerReisetage"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/edit_text_bg" />
            </LinearLayout>

            <!-- Sparpreis fields -->
            <LinearLayout
                android:id="@+id/layoutSparpreis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/von_station"
                    android:textSize="13sp"
                    android:textColor="@color/defaultTextColorGrey"
                    android:fontFamily="@font/dbsans_regular"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/spinnerVon"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/edit_text_bg" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nach_station"
                    android:textSize="13sp"
                    android:textColor="@color/defaultTextColorGrey"
                    android:fontFamily="@font/dbsans_regular"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/spinnerNach"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/edit_text_bg" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.DBTickets.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/zug_typ">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etZugTyp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:text="ICE"
                        android:textColor="@color/defaultTextColor"
                        android:fontFamily="@font/dbsans_regular" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.DBTickets.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/zug_nummer">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etZugNummer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="@color/defaultTextColor"
                        android:fontFamily="@font/dbsans_regular" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Gueltig von -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.DBTickets.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/gueltig_von">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etGueltigVon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="date"
                    android:focusable="false"
                    android:clickable="true"
                    android:textColor="@color/defaultTextColor"
                    android:fontFamily="@font/dbsans_regular" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Gueltig bis -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutGueltigBis"
                style="@style/Widget.DBTickets.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:hint="@string/gueltig_bis">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etGueltigBis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="date"
                    android:focusable="false"
                    android:clickable="true"
                    android:textColor="@color/defaultTextColor"
                    android:fontFamily="@font/dbsans_regular" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Submit Button -->
    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="20dp"
        android:text="@string/ticket_erstellen"
        style="@style/DBPrimaryButton" />

</LinearLayout>
