<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/db_cool_gray_100">

    <!-- Dark Top Bar (DB Navigator Style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/db_cool_gray_700"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/db_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u22EE"
            android:textColor="@color/db_white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:clickable="true"
            android:focusable="true"
            android:onClick="onMenuClick" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Search Section with white background (like DB Navigator home top) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/db_white"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ticket_abrufen"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="4dp" />

                    <!-- Red underline like DB Navigator -->
                    <View
                        android:layout_width="60dp"
                        android:layout_height="4dp"
                        android:background="@color/db_red"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ticket_abrufen_beschreibung"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="16dp" />

                    <!-- Input field with border -->
                    <EditText
                        android:id="@+id/etAuftragsnummer"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="z.B. 2597538415754"
                        android:inputType="number"
                        android:background="@drawable/edit_text_bg"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/db_red"
                        android:visibility="gone"
                        android:layout_marginBottom="8dp" />

                    <!-- Red Button (DB Navigator style) -->
                    <Button
                        android:id="@+id/btnLoadTicket"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/ticket_laden"
                        android:textColor="@color/db_white"
                        android:textSize="16sp"
                        android:textAllCaps="false"
                        android:backgroundTint="@color/db_red" />

                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        android:layout_marginTop="8dp"
                        android:indeterminateTint="@color/db_red" />
                </LinearLayout>

                <!-- Shadow separator -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:background="@drawable/drop_shadow" />

                <!-- Tickets Section (grey background like DB Navigator cards area) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <!-- Search field -->
                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="@string/tickets_durchsuchen"
                        android:inputType="text"
                        android:background="@drawable/search_bg"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:drawableStart="@android:drawable/ic_menu_search"
                        android:drawablePadding="8dp"
                        android:visibility="gone"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvRecentTickets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/letzte_tickets"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="12dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvNoTickets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/noch_keine_tickets"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:layout_marginTop="32dp"
                        android:layout_marginBottom="32dp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvTickets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:clipToPadding="false"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
