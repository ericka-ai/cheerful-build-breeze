<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme matching DB Navigator's BaseAppTheme -->
    <style name="BaseAppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar.Bridge">
        <item name="android:windowBackground">@color/greyBackground</item>
        <item name="android:textColor">@color/defaultTextColor</item>
        <item name="android:fontFamily">@font/dbsans_font_family</item>
        <item name="android:scrollbars">none</item>
        <item name="android:listDivider">@drawable/line_divider</item>
        <item name="colorPrimary">@color/dbRed</item>
        <item name="colorPrimaryDark">@color/dbCoolGray800</item>
        <item name="colorAccent">@color/dbRed</item>
    </style>

    <!-- App theme with dark status bar -->
    <style name="Theme.DBTickets" parent="BaseAppTheme">
        <item name="android:statusBarColor">@color/dbCoolGray800</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/dbCoolGray800</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- DB Navigator primary button style -->
    <style name="DBPrimaryButton">
        <item name="android:background">@drawable/background_rounded_button</item>
        <item name="android:textColor">@color/dbWhite</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/dbsans_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <!-- DB Navigator border/outlined button style -->
    <style name="DBBorderButton">
        <item name="android:background">@drawable/background_border_transparent</item>
        <item name="android:textColor">@color/borderButtonTextEnabled</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/dbsans_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <!-- Material button variants for backward compat -->
    <style name="Widget.DBTickets.Button.Gray" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/primaryButtonEnabled</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/dbsans_bold</item>
        <item name="android:textColor">@color/dbWhite</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.DBTickets.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/dbsans_bold</item>
        <item name="strokeColor">@color/borderButtonEnabled</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/defaultTextColor</item>
    </style>

    <style name="Widget.DBTickets.Button.Red" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/dbRed</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/dbsans_bold</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Card style matching DB Navigator -->
    <style name="Widget.DBTickets.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">4dp</item>
        <item name="cardElevation">6dp</item>
        <item name="cardBackgroundColor">@color/lightBackground</item>
    </style>

    <!-- Text input -->
    <style name="Widget.DBTickets.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">4dp</item>
        <item name="boxCornerRadiusTopEnd">4dp</item>
        <item name="boxCornerRadiusBottomStart">4dp</item>
        <item name="boxCornerRadiusBottomEnd">4dp</item>
        <item name="boxStrokeColor">@color/lineDivider</item>
        <item name="hintTextColor">@color/defaultTextColorGrey</item>
        <item name="android:textColorHint">@color/dbCoolGray400</item>
    </style>

    <!-- DB Spinner theme -->
    <style name="DBSpinnerTheme" parent="BaseAppTheme">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/dbsans_regular</item>
    </style>
</resources>
