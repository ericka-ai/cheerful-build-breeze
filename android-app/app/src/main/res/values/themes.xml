<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Force dark theme like DB Navigator -->
    <style name="Theme.DBTickets" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/db_red</item>
        <item name="colorPrimaryDark">@color/db_red_dark</item>
        <item name="colorAccent">@color/db_red</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:navigationBarColor">@color/nav_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <!-- DB Navigator style gray button -->
    <style name="Widget.DBTickets.Button.Gray" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/button_gray</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/db_white</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Outlined button (like "Aktualisieren" in DB Navigator) -->
    <style name="Widget.DBTickets.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textSize">15sp</item>
        <item name="strokeColor">@color/text_secondary</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Red accent button (rare, for primary actions) -->
    <style name="Widget.DBTickets.Button.Red" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/db_red</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Card style matching DB Navigator -->
    <style name="Widget.DBTickets.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/card_bg</item>
    </style>

    <!-- Text input matching dark theme -->
    <style name="Widget.DBTickets.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxStrokeColor">@color/divider</item>
        <item name="boxBackgroundColor">@color/input_bg</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>
</resources>
